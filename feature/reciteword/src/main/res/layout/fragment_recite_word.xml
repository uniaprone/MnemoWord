<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.kite.mnemoai.ui.widget.BannerView
        android:id="@+id/bannerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="?attr/colorPrimaryContainer"
        android:visibility="gone"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/statusReciteWordNotStarted"
            layout="@layout/status_recite_word_not_started"
            android:visibility="gone"/>

        <include
            android:id="@+id/statusReciteWordFinish"
            layout="@layout/status_recite_word_finish"
            android:visibility="gone"/>

        <include
            android:id="@+id/statusReciteWordNoVocabulary"
            layout="@layout/status_recite_word_no_vocabulary"
            android:visibility="gone"/>

        <include
            android:id="@+id/statusReciteWordOK"
            layout="@layout/status_recite_word_ok"
            android:visibility="gone"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>