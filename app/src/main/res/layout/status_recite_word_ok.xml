<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/statusReciteWordOKCL">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/reciteIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/linearProgressIndicator"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_marginVertical="4dp"
            android:layout_marginHorizontal="8dp"
            android:indeterminate="false"
            app:layout_constraintBottom_toBottomOf="@+id/reciteIndicator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/numberProgressTV"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="6dp"
            app:trackCornerRadius="3dp"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/numberProgressTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:layout_marginHorizontal="8dp"
            android:text="@string/number_progress"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ViewFlipper
        android:id="@+id/wordCardVF"
        android:transitionGroup="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:inAnimation="@anim/slide_in_right"
        android:outAnimation="@anim/slide_in_left"
        app:layout_constraintBottom_toTopOf="@+id/actionLL"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reciteIndicator">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/wordContentCL"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/wordCV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"

                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurfaceContainer"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/headerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/colorSurfaceContainerLowest"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/wordTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="@dimen/text_size_headline_large"
                            android:textStyle="bold"
                            tools:text="bedroom" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/phoneticTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="4dp"
                            android:gravity="center"
                            tools:text="\'bedrum\" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/translateTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:visibility="gone"
                            tools:text="n.卧室" />

                        <LinearLayout
                            android:id="@+id/showWordDefinitionLL"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingVertical="100dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:src="@drawable/baseline_remove_red_eye_24" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="点击查看单词释义" />

                        </LinearLayout>
                    </LinearLayout>

                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/aiMnemonicNSV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/colorSurfaceContainer"
                        android:clipChildren="false"
                        android:fillViewport="false">

                        <include
                            android:id="@+id/ai_mnemonic"
                            layout="@layout/ai_mnemonic"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ViewFlipper>


    <LinearLayout
        android:id="@+id/actionLL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <!-- 不认识 -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:id="@+id/forgetBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/forget"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:textSize="@dimen/text_size_body_large"
            app:elevation="10dp"
            app:backgroundTint="?attr/colorTertiaryContainer"
            android:layout_marginEnd="8dp"/>
        <!-- 模糊 -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:id="@+id/blurBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/blur"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="@dimen/text_size_body_large"
            app:backgroundTint="?attr/colorSecondaryContainer"
            android:layout_marginEnd="8dp"/>
        <!-- 认识 -->
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:id="@+id/rememberBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/remember"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="@dimen/text_size_body_large"
            app:backgroundTint="?attr/colorPrimaryContainer"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>