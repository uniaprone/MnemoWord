<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:overScrollMode="never"
    android:fillViewport="true"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:id="@+id/wordDetailLL"
    android:background="?attr/colorSurfaceContainer">

        <!-- 词形信息-->
        <LinearLayout
            android:id="@+id/wordForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp"
            android:background="?attr/colorSurfaceContainerLowest">
                <LinearLayout
                    android:id="@+id/wordFormLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="@string/word_form_info"
                            android:textSize="@dimen/text_size_title_medium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="wrap_content"
                            android:layout_height="0.5dp"
                            app:dividerColor="?attr/colorOutlineVariant"/>
                </LinearLayout>
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/wordFormFBL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:orientation="horizontal"
                    app:flexWrap="wrap"
                    app:justifyContent="flex_start"
                    app:alignItems="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/wordPosTV"
                    app:layout_constraintTop_toTopOf="parent" />
        </LinearLayout>

        <!-- 助记信息-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurfaceContainerLowest">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/extractTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ai_mnemonic"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/text_size_title_medium"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:chipSpacingHorizontal="4dp">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/generateAIMnemonicChip"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/generate_mnemonic"
                                    android:textColor="?attr/colorOnTertiaryContainer"
                                    android:textSize="@dimen/text_size_body_small"
                                    app:chipBackgroundColor="?attr/colorTertiaryContainer"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipCornerRadius="16dp"
                                    app:chipEndPadding="0dp"
                                    app:chipStartPadding="0dp"
                                    app:ensureMinTouchTargetSize="false" />

<!--                                <com.google.android.material.chip.Chip-->
<!--                                    android:id="@+id/communicateWithAIChip"-->
<!--                                    android:layout_width="wrap_content"-->
<!--                                    android:layout_height="wrap_content"-->
<!--                                    android:text="@string/communicate_with_ai"-->
<!--                                    android:textColor="?attr/colorOnTertiaryContainer"-->
<!--                                    android:textSize="@dimen/text_size_body_small"-->
<!--                                    app:chipBackgroundColor="?attr/colorTertiaryContainer"-->
<!--                                    app:chipStrokeColor="?attr/colorOutline"-->
<!--                                    app:chipCornerRadius="16dp"-->
<!--                                    app:chipEndPadding="0dp"-->
<!--                                    app:chipStartPadding="0dp"-->
<!--                                    app:ensureMinTouchTargetSize="false" />-->
                        </com.google.android.material.chip.ChipGroup>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/colorSurfaceContainer">
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="wrap_content"
                            android:layout_height="0.5dp"
                            app:dividerColor="?attr/colorOutlineVariant"/>
                        <FrameLayout
                                    android:id="@+id/AIGenerateBanner"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="?attr/colorPrimaryContainer"
                                    android:visibility="gone"
                                    tools:ignore="UselessParent">
                                        <com.google.android.material.textview.MaterialTextView
                                            android:id="@+id/AIGenerateResultTV"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            tools:text="生成中......"
                                            android:textSize="@dimen/text_size_body_medium"
                                            android:gravity="center"
                                            android:padding="8dp"/>
                        </FrameLayout>
                        <LinearLayout
                            android:id="@+id/noExtractContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    app:strokeWidth="0dp"
                                    app:cardCornerRadius="0dp"
                                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">
                                        <com.google.android.material.textview.MaterialTextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="8dp"
                                            android:text="@string/no_ai_mnemonic_info"
                                            android:textSize="@dimen/text_size_body_large"
                                            android:textColor="?attr/colorOnSurface"/>
                                </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/extractContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:orientation="vertical"
                            android:visibility="gone">
                                <!-- Core Image -->
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    app:strokeWidth="0dp"
                                    app:cardCornerRadius="0dp"
                                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp"
                                            android:orientation="vertical">
                                                <com.google.android.material.textview.MaterialTextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:text="@string/core_image"
                                                    android:textSize="@dimen/text_size_body_medium"
                                                    android:textColor="?attr/colorOnSurfaceVariant"/>

                                                <com.google.android.material.textview.MaterialTextView
                                                    android:id="@+id/coreImageTV"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="6dp"
                                                    android:textSize="15sp"
                                                    tools:text="睡觉"
                                                    android:textColor="?attr/colorOnSurface"/>
                                        </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                                <!-- Affix -->
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    app:cardCornerRadius="0dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp"
                                            android:orientation="vertical">
                                                <com.google.android.material.textview.MaterialTextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:text="@string/affix"
                                                    android:textSize="@dimen/text_size_body_medium"
                                                    android:textColor="?attr/colorOnSurfaceVariant"/>

                                                <com.google.android.material.textview.MaterialTextView
                                                    android:id="@+id/affixTV"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="6dp"
                                                    android:textSize="15sp"
                                                    tools:text="a sleep"
                                                    android:textColor="?attr/colorOnSurface"/>
                                        </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                                <!-- Explain -->
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    app:cardCornerRadius="0dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp"
                                            android:orientation="vertical">
                                                <com.google.android.material.textview.MaterialTextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:text="@string/word_explain"
                                                    android:textSize="@dimen/text_size_body_medium"
                                                    android:textColor="?attr/colorOnSurfaceVariant"/>

                                                <com.google.android.material.textview.MaterialTextView
                                                    android:id="@+id/explainTV"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="6dp"
                                                    android:textSize="15sp"
                                                    tools:text="睡觉"
                                                    android:textColor="?attr/colorOnSurface"/>
                                        </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                                <!-- Example Sentences -->
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="4dp"
                                    app:cardCornerRadius="0dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp"
                                            android:orientation="vertical">
                                                <com.google.android.material.textview.MaterialTextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:text="@string/example_sentences"
                                                    android:textSize="@dimen/text_size_body_medium"
                                                    android:textColor="?attr/colorOnSurfaceVariant"/>

                                                <LinearLayout
                                                    android:id="@+id/exampleSentenceLL"
                                                    android:orientation="vertical"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="6dp"/>
                                        </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>

                                <!-- Phrase -->
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:cardCornerRadius="0dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">
                                        <LinearLayout
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp"
                                            android:orientation="vertical">
                                                <com.google.android.material.textview.MaterialTextView
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:text="@string/phrases"
                                                    android:textSize="@dimen/text_size_body_medium"
                                                    android:textColor="?attr/colorOnSurfaceVariant"/>

                                                <LinearLayout
                                                    android:id="@+id/phraseLL"
                                                    android:orientation="vertical"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_marginTop="6dp"/>
                                        </LinearLayout>

                                </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                </LinearLayout>
        </LinearLayout>
        <!-- 学习历史-->
        <LinearLayout
            android:id="@+id/studyHistoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurfaceContainerLowest">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/study_history"
                    android:textSize="@dimen/text_size_title_medium"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="?attr/colorSurfaceContainer">
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="wrap_content"
                            android:layout_height="0.5dp"
                            app:dividerColor="?attr/colorOutlineVariant"/>
                        <LinearLayout
                            android:id="@+id/noStudyHistoryContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="8dp"
                                    app:cardCornerRadius="0dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">
                                        <com.google.android.material.textview.MaterialTextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_margin="8dp"
                                            android:text="@string/no_study_history"
                                            android:textSize="@dimen/text_size_body_large"
                                            android:textColor="?attr/colorOnSurface"/>

                                </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/studyHistoryContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    app:cardCornerRadius="0dp"
                                    app:strokeWidth="0dp"
                                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">
                                        <androidx.recyclerview.widget.RecyclerView
                                            android:id="@+id/studyHistoryItemsRV"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:padding="8dp">
                                        </androidx.recyclerview.widget.RecyclerView>

                                </com.google.android.material.card.MaterialCardView>
                        </LinearLayout>
                </LinearLayout>
        </LinearLayout>


</LinearLayout>