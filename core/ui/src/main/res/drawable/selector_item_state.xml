<!-- res/drawable/selector_item_state.xml -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorPrimaryContainer">   <!-- 涟漪的颜色 = 最终填充色 -->

    <!-- 这里包裹你原来的 selector，作为水波纹的“内容层” -->
    <item>
        <selector>
            <!-- 选中状态：最终显示为纯色背景 -->
            <item android:state_checked="true">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="?attr/colorPrimaryContainer" />
                </shape>
            </item>

            <!-- 未选中状态：透明背景 + 边框（让按钮有可见边界） -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/colorOutline" /> <!-- 用主题轮廓色 -->
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>