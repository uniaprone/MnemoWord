<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.MyApp.CardView.Primary" parent="Widget.Material3.CardView.Filled">
    </style>

    <style name="Widget.MyApp.CardView.Small" parent="Widget.MyApp.CardView.Primary">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.MyApp.CardView.Middle" parent="Widget.MyApp.CardView.Primary">
        <item name="cornerRadius">6dp</item>
    </style>

    <style name="Widget.MyApp.CardView.Large" parent="Widget.Material3.CardView.Elevated">
        <item name="cardElevation">0dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="CustomAlertDialog" parent="">
        <item name="shapeAppearanceOverlay">@style/CustomDialogShape</item>
    </style>

    <style name="CustomDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="OverflowMenuStyle" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:overlapAnchor">false</item>
        <item name="android:popupBackground">@drawable/bg_overflow_menu</item>
    </style>


    <style name="MaiSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupBackground">@drawable/bg_spinner_drow_down</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
        <item name="android:dropDownHorizontalOffset">0dp</item>
        <item name="android:popupElevation">2dp</item>
        <item name="android:overlapAnchor">false</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_spinner</item>
    </style>
</resources>
