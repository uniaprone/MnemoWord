<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.MyApp.CardView.Small"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:id="@+id/wordListItemCardView"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp" >

        <View
            android:id="@+id/statusView"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/wordTextView"
            app:layout_constraintBottom_toBottomOf="@id/wordTextView"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/wordTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="abandon"
            android:textStyle="bold"
            android:textSize="18sp"
            app:layout_constraintStart_toEndOf="@id/statusView"
            app:layout_constraintTop_toTopOf="parent"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/phoneticTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="/əˈbændən/"
            android:textSize="13sp"
            app:layout_constraintBaseline_toBaselineOf="@id/wordTextView"
            app:layout_constraintStart_toEndOf="@id/wordTextView"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/meaningTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="放弃；遗弃"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="@id/wordTextView"
            app:layout_constraintTop_toBottomOf="@id/wordTextView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
