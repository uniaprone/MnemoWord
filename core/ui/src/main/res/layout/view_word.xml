<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainerLowest">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainerCL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            android:background="?attr/colorSurfaceContainerLowest"
            android:gravity="start"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/aiChipGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/wordTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_size_headline_large"
                android:textStyle="bold"
                tools:text="bedroom" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/phoneticTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:gravity="center"
                    tools:text="\'bedrum\" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/pronounce" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/aiChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.chip.Chip
                android:id="@+id/generateAIMnemonicChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/generate_mnemonic"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="@dimen/text_size_body_small"
                app:chipBackgroundColor="?attr/colorPrimaryContainer"
                app:chipCornerRadius="8dp"
                app:chipEndPadding="0dp"
                app:chipStartPadding="0dp"
                app:chipStrokeColor="?attr/colorPrimary"
                app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/communicateWithAIChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/communicate_with_ai"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:textSize="@dimen/text_size_body_small"
                app:chipBackgroundColor="?attr/colorTertiaryContainer"
                app:chipStrokeColor="?attr/colorTertiary"
                app:chipCornerRadius="8dp"
                app:chipEndPadding="0dp"
                app:chipStartPadding="0dp"
                app:ensureMinTouchTargetSize="false" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/wordTranslationLL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:paddingBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerContainerCL"/>

    <LinearLayout
        android:id="@+id/showWordDefinitionLL"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/colorSurfaceContainerLowest"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/wordTranslationLL"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_remove_red_eye_24"
            app:tint="?attr/colorPrimary"/>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/click_to_view_word_definition"
            android:textSize="@dimen/text_size_body_medium"
            android:textColor="?attr/colorOnSurfaceVariant"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>